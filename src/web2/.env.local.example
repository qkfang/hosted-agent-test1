# AG-UI (invocations) endpoint of the hosted agent.
#
# Local hosted-agent run (`azd ai agent run`, default port 8088):
AGUI_BACKEND_URL=http://localhost:8088/invocations
#
# When pointing at a DEPLOYED Foundry hosted agent, set the full invocations URL, e.g.:
#   AGUI_BACKEND_URL=https://<account>.services.ai.azure.com/api/projects/<project>/agents/agent-framework-workflows-responses/endpoint/protocols/invocations
# and enable Entra auth so the runtime attaches a bearer token server-side:
AGUI_USE_ENTRA_AUTH=false
